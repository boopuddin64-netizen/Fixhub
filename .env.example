# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps Platform Configuration
# Maps JavaScript API, Places API (New), Geocoding API, Routes API
# Obtain via Google Cloud Console or free Maps Demo Key for prototyping:
# https://mapsplatform.google.com/maps-demo-key
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
JWT_SECRET="fixhub-dev-secret-key-production-change-me"
PAYMENT_MODE="sandbox" # "sandbox" or "live"
PAYSTACK_SECRET_KEY="sk_test_xxx" # Regulated provider for Nigerian Market (Paystack/Flutterwave)
PLATFORM_COMMISSION_PERCENT="8.5"
DATABASE_URL="postgres://user:password@localhost:5432/fixhub"
